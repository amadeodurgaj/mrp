    {
      "name": "Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {",
              "    jsonData = null;",
              "    console.error(\"Response is not valid JSON\");",
              "}",
              "",
              "if (jsonData && typeof jsonData.token === 'string' && jsonData.token.length > 0) {",
              "    pm.environment.set('token', jsonData.token);",
              "    console.log(\"Token saved to global variable\");",
              "}",
              "",
              "pm.test(\"Token field exists and is not empty\", function () {",
              "    pm.expect(jsonData).to.not.be.null;",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.expect(jsonData.token).to.be.a('string').and.not.be.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
